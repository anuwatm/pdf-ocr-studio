# ==============================================================================
# Local LLM Configuration (Phase 3: AI Text Correction)
# ==============================================================================
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=google/gemma-3-1b
LLM_API_KEY=not-needed
LLM_TIMEOUT=60.0

# ==============================================================================
# Local Server Binding (Phase 6: Default Loopback only)
# ==============================================================================
HOST=127.0.0.1
PORT=8000
LOCALHOST_ONLY=true

# ==============================================================================
# Data Retention TTL in seconds (Phase 6: Default 86400s = 24 hours)
# ==============================================================================
RETENTION_SECONDS=86400.0

# ==============================================================================
# Optional Google Cloud Translation v3 (cloud opt-in; ADC/service account only)
# Never put a credential JSON body or API key in this file.
# ==============================================================================
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_TRANSLATION_PRICE_PER_MILLION_CHARS=0
